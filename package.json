{
  "name": "simple-todo-native",
  "version": "1.0.0",
  "description": "The Simple Todo app as a native SwiftUI app, built by EAS Build and run on Expo Simulators. Tooling metadata only: no JavaScript runtime.",
  "repository": "github:jacobhammerle/todo-app-native",
  "license": "MIT",
  "private": true,
  "scripts": {
    "xcodegen": "xcodegen generate --spec ios/project.yml --project ios",
    "build:simulator": "bash scripts/build-simulator-app.sh",
    "smoke": "bash scripts/expo-simulator/smoke-test.sh",
    "preview": "bash scripts/expo-simulator/live-preview.sh",
    "qa:lane": "bash scripts/agent/qa-flow.sh"
  },
  "devDependencies": {
    "eas-simulator-evidence": "^0.2.3"
  }
}
